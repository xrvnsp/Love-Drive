<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- True Fullscreen Surface rendering on Android Auto head unit -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_love_drive"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_love_drive"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoveDrive">

        <!-- Template-only descriptor so Android Auto ALWAYS launches the Fullscreen Canvas -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HeadUnitPreviewActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- Pure Fullscreen Surface Canvas Service (replaces Media player conflict) -->
        <service
            android:name=".LoveDriveCarAppService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/ic_love_drive">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

    </application>

</manifest>
